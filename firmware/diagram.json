    [ "esp:26", "r1:1", "green", [] ],
    [ "r1:2", "ledUp:A", "green", [] ],
    [ "ledUp:C", "esp:GND.2", "black", [] ],
    [ "esp:27", "r2:1", "red", [] ],
    [ "r2:2", "ledDown:A", "red", [] ],
    [ "ledDown:C", "esp:GND.2", "black", [] ],

    [ "btn1:1.l", "esp:14", "blue", [] ],
