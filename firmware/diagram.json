    { "type": "wokwi-max7219-matrix", "id": "matrix1", "top": -150, "left": -60, "attrs": { "chain": "4", "layout": "fc16" } },
    { "type": "wokwi-servo", "id": "servo1", "top": 40, "left": 220, "attrs": {} },
    { "type": "wokwi-led", "id": "ledUp", "top": 180, "left": 230, "attrs": { "color": "limegreen" } },
    { "type": "wokwi-led", "id": "ledDown", "top": 180, "left": 290, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 260, "left": 200, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r2", "top": 260, "left": 260, "rotate": 90, "attrs": { "value": "220" } },
